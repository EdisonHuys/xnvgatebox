name = "xnvgatebox"
main = "worker.mjs"
compatibility_date = "2026-10-10"
workers_dev = true

[vars]
# All runtime settings are ordinary Worker variables. Replace the examples
# before deployment; no other Worker is required.
DATA_PLANE_BASE_PATH = "/"
VLESS_UUID = "replace-with-uuid-v4"
ADMIN_TOKEN = "replace-with-admin-token"
SUB_TOKEN = "replace-with-subscription-token"
VPN_USERNAME = "vpn"
VPN_PASSWORD = "vpn"
CHECKER_TOKEN = "replace-with-checker-token"

[[kv_namespaces]]
binding = "MANIFEST"
id = "replace-with-the-single-manifest-kv-id"

# Secrets: VLESS_UUID, ADMIN_TOKEN, SUB_TOKEN, VPN_USERNAME, VPN_PASSWORD,
# CHECKER_TOKEN. The last one is only used while the single Worker replaces
# the first-round checker implementation.
