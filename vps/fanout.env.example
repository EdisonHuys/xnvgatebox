# Copy to /etc/default/xnvgatebox-fanout on the VPS.  Do not commit the live file.
FANOUT_VALIDATED_POOL_FILE=/var/lib/xnvgatebox/pool/node_pool.json
FANOUT_SLOT_PORT_BASE=17928
FANOUT_RESIDENTIAL_ONLY=0
# Optional first slot country; no fixed country template.
# FANOUT_INITIAL_REGION=JP
# Set this to the VPS public IPv4 so a namespace falling back through NAT is rejected.
FANOUT_PUBLIC_IP=

# Cloudflare / CDN 救砖配置（当 VPS IP 被墙时配合小黄云使用）
# FANOUT_CDN_DOMAIN=ali.edisonhu.xyz
# FANOUT_CDN_PORT=443
# FANOUT_CDN_PATH=/ali-ws
